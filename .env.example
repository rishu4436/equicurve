# Solana RPC (devnet recommended for MVP)
# Prefer Helius / Triton / QuickNode in production — public endpoints are rate-limited.
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com

# Server-only dedicated RPC for API routes (registry verification, Explore
# enrichment, /api/health). Not exposed to the browser. Falls back to
# NEXT_PUBLIC_RPC_URL when unset. Never commit a real keyed URL.
# RPC_URL=

# Cluster label for explorers / UI
NEXT_PUBLIC_CLUSTER=devnet

# Optional: reuse an existing DBC PoolConfig instead of creating one per launch.
# Create via https://launch.meteora.ag or SDK partner.createConfig
# NEXT_PUBLIC_POOL_CONFIG_KEY=

# Optional sanity override for the DAMM v2 migration config. Migration always
# uses the config required by the pool's migrationFeeOption; if this is set and
# differs, the app refuses to build the migrate tx.
# NEXT_PUBLIC_DAMM_V2_CONFIG=

# Optional: executable Token-2022 transfer-hook program for Create → Transfer profile.
# Required to enable the transfer-hook path (never invent a fake program ID).
# NEXT_PUBLIC_TRANSFER_HOOK_PROGRAM=

# --- EquiCurve Explore launch registry (durable storage) ---
# Default (no vars): local JSON file at data/launches/registry.json — fine for `next dev`.
# On Vercel / serverless the filesystem is ephemeral; set Upstash for durable registry:
#
# 1. Create a free Redis DB at https://console.upstash.com/
# 2. Copy REST URL + REST TOKEN into Vercel Project → Settings → Environment Variables
# 3. Redeploy. Settings / GET /api/health will show registry.backend = "upstash".
#
# Never commit real tokens. Leave unset for local file backend.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
